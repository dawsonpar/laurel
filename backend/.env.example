ENVIRONMENT=development
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-005
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://laurel.vercel.app

# Production share-link persistence (leave unset to use local filesystem store)
MOMENTS_BUCKET=
FIRESTORE_COLLECTION=laurel-moments
